<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.product.mapper.PlatformPromotionConfigMapper">
    
    <resultMap type="PlatformPromotionConfig" id="PlatformPromotionConfigResult">
        <result property="id"    column="id"    />
        <result property="priceMin"    column="price_min"    />
        <result property="priceMax"    column="price_max"    />
        <result property="thresholdAmount"    column="threshold_amount"    />
        <result property="discountAmount"    column="discount_amount"    />
        <result property="discountRate"    column="discount_rate"    />
        <result property="discountStrength"    column="discount_strength"    />
        <result property="priority"    column="priority"    />
        <result property="configId"    column="config_id"    />
        <result property="configName"    column="config_name"    />
        <result property="discountStatus"    column="discount_status"    />
        <result property="discountType"    column="discount_type"    />
        <result property="recommendedQuantity"    column="recommended_quantity"    />
        <result property="gmtCreate"    column="gmt_create"    />
        <result property="gmtModified"    column="gmt_modified"    />
    </resultMap>

    <sql id="selectPlatformPromotionConfigVo">
        select id, price_min, price_max, threshold_amount, discount_amount, discount_rate, discount_strength, priority, config_id, config_name, discount_status, discount_type, recommended_quantity, gmt_create, gmt_modified from platform_promotion_config
    </sql>

    <select id="selectPlatformPromotionConfigList" parameterType="PlatformPromotionConfig" resultMap="PlatformPromotionConfigResult">
        <include refid="selectPlatformPromotionConfigVo"/>
        <where>  
            <if test="priceMin != null "> and price_min = #{priceMin}</if>
            <if test="priceMax != null "> and price_max = #{priceMax}</if>
            <if test="thresholdAmount != null "> and threshold_amount = #{thresholdAmount}</if>
            <if test="discountAmount != null "> and discount_amount = #{discountAmount}</if>
            <if test="discountRate != null "> and discount_rate = #{discountRate}</if>
            <if test="discountStrength != null "> and discount_strength = #{discountStrength}</if>
            <if test="priority != null "> and priority = #{priority}</if>
            <if test="configId != null  and configId != ''"> and config_id = #{configId}</if>
            <if test="configName != null  and configName != ''"> and config_name like concat('%', #{configName}, '%')</if>
            <if test="discountStatus != null  and discountStatus != ''"> and discount_status = #{discountStatus}</if>
            <if test="discountType != null  and discountType != ''"> and discount_type = #{discountType}</if>
            <if test="recommendedQuantity != null "> and recommended_quantity = #{recommendedQuantity}</if>
            <if test="gmtCreate != null "> and gmt_create = #{gmtCreate}</if>
            <if test="gmtModified != null "> and gmt_modified = #{gmtModified}</if>
        </where>
    </select>
    
    <select id="selectPlatformPromotionConfigById" parameterType="String" resultMap="PlatformPromotionConfigResult">
        <include refid="selectPlatformPromotionConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertPlatformPromotionConfig" parameterType="PlatformPromotionConfig">
        insert into platform_promotion_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="priceMin != null">price_min,</if>
            <if test="priceMax != null">price_max,</if>
            <if test="thresholdAmount != null">threshold_amount,</if>
            <if test="discountAmount != null">discount_amount,</if>
            <if test="discountRate != null">discount_rate,</if>
            <if test="discountStrength != null">discount_strength,</if>
            <if test="priority != null">priority,</if>
            <if test="configId != null and configId != ''">config_id,</if>
            <if test="configName != null and configName != ''">config_name,</if>
            <if test="discountStatus != null">discount_status,</if>
            <if test="discountType != null">discount_type,</if>
            <if test="recommendedQuantity != null">recommended_quantity,</if>
            <if test="gmtCreate != null">gmt_create,</if>
            <if test="gmtModified != null">gmt_modified,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="priceMin != null">#{priceMin},</if>
            <if test="priceMax != null">#{priceMax},</if>
            <if test="thresholdAmount != null">#{thresholdAmount},</if>
            <if test="discountAmount != null">#{discountAmount},</if>
            <if test="discountRate != null">#{discountRate},</if>
            <if test="discountStrength != null">#{discountStrength},</if>
            <if test="priority != null">#{priority},</if>
            <if test="configId != null and configId != ''">#{configId},</if>
            <if test="configName != null and configName != ''">#{configName},</if>
            <if test="discountStatus != null">#{discountStatus},</if>
            <if test="discountType != null">#{discountType},</if>
            <if test="recommendedQuantity != null">#{recommendedQuantity},</if>
            <if test="gmtCreate != null">#{gmtCreate},</if>
            <if test="gmtModified != null">#{gmtModified},</if>
         </trim>
    </insert>

    <update id="updatePlatformPromotionConfig" parameterType="PlatformPromotionConfig">
        update platform_promotion_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="priceMin != null">price_min = #{priceMin},</if>
            <if test="priceMax != null">price_max = #{priceMax},</if>
            <if test="thresholdAmount != null">threshold_amount = #{thresholdAmount},</if>
            <if test="discountAmount != null">discount_amount = #{discountAmount},</if>
            <if test="discountRate != null">discount_rate = #{discountRate},</if>
            <if test="discountStrength != null">discount_strength = #{discountStrength},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="configId != null and configId != ''">config_id = #{configId},</if>
            <if test="configName != null and configName != ''">config_name = #{configName},</if>
            <if test="discountStatus != null">discount_status = #{discountStatus},</if>
            <if test="discountType != null">discount_type = #{discountType},</if>
            <if test="recommendedQuantity != null">recommended_quantity = #{recommendedQuantity},</if>
            <if test="gmtCreate != null">gmt_create = #{gmtCreate},</if>
            <if test="gmtModified != null">gmt_modified = #{gmtModified},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePlatformPromotionConfigById" parameterType="String">
        delete from platform_promotion_config where id = #{id}
    </delete>

    <delete id="deletePlatformPromotionConfigByIds" parameterType="String">
        delete from platform_promotion_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>