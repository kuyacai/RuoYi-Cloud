<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.product.mapper.AsyncTaskMapper">
    
    <resultMap type="AsyncTask" id="AsyncTaskResult">
        <result property="taskId"    column="task_id"    />
        <result property="taskCode"    column="task_code"    />
        <result property="taskName"    column="task_name"    />
        <result property="fileName"    column="file_name"    />
        <result property="total"    column="total"    />
        <result property="success"    column="success"    />
        <result property="skip"    column="skip"    />
        <result property="failure"    column="failure"    />
        <result property="failFileUrl"    column="fail_file_url"    />
        <result property="taskStatus"    column="task_status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="finishTime"    column="finish_time"    />
    </resultMap>

    <sql id="selectAsyncTaskVo">
        select task_id, task_code, task_name, file_name, total, success, skip, failure, fail_file_url, task_status, create_by, create_time, finish_time from async_task
    </sql>

    <select id="selectAsyncTaskList" parameterType="AsyncTask" resultMap="AsyncTaskResult">
        <include refid="selectAsyncTaskVo"/>
        <where>  
            <if test="taskCode != null  and taskCode != ''"> and task_code = #{taskCode}</if>
            <if test="taskName != null  and taskName != ''"> and task_name like concat('%', #{taskName}, '%')</if>
            <if test="fileName != null  and fileName != ''"> and file_name like concat('%', #{fileName}, '%')</if>
            <if test="total != null "> and total = #{total}</if>
            <if test="success != null "> and success = #{success}</if>
            <if test="skip != null "> and skip = #{skip}</if>
            <if test="failure != null "> and failure = #{failure}</if>
            <if test="failFileUrl != null  and failFileUrl != ''"> and fail_file_url = #{failFileUrl}</if>
            <if test="taskStatus != null  and taskStatus != ''"> and task_status = #{taskStatus}</if>
            <if test="finishTime != null "> and finish_time = #{finishTime}</if>
        </where>
    </select>
    
    <select id="selectAsyncTaskByTaskId" parameterType="String" resultMap="AsyncTaskResult">
        <include refid="selectAsyncTaskVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertAsyncTask" parameterType="AsyncTask">
        insert into async_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskId != null">task_id,</if>
            <if test="taskCode != null and taskCode != ''">task_code,</if>
            <if test="taskName != null">task_name,</if>
            <if test="fileName != null">file_name,</if>
            <if test="total != null">total,</if>
            <if test="success != null">success,</if>
            <if test="skip != null">skip,</if>
            <if test="failure != null">failure,</if>
            <if test="failFileUrl != null">fail_file_url,</if>
            <if test="taskStatus != null">task_status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="finishTime != null">finish_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskId != null">#{taskId},</if>
            <if test="taskCode != null and taskCode != ''">#{taskCode},</if>
            <if test="taskName != null">#{taskName},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="total != null">#{total},</if>
            <if test="success != null">#{success},</if>
            <if test="skip != null">#{skip},</if>
            <if test="failure != null">#{failure},</if>
            <if test="failFileUrl != null">#{failFileUrl},</if>
            <if test="taskStatus != null">#{taskStatus},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="finishTime != null">#{finishTime},</if>
         </trim>
    </insert>

    <update id="updateAsyncTask" parameterType="AsyncTask">
        update async_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskCode != null and taskCode != ''">task_code = #{taskCode},</if>
            <if test="taskName != null">task_name = #{taskName},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="total != null">total = #{total},</if>
            <if test="success != null">success = #{success},</if>
            <if test="skip != null">skip = #{skip},</if>
            <if test="failure != null">failure = #{failure},</if>
            <if test="failFileUrl != null">fail_file_url = #{failFileUrl},</if>
            <if test="taskStatus != null">task_status = #{taskStatus},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteAsyncTaskByTaskId" parameterType="String">
        delete from async_task where task_id = #{taskId}
    </delete>

    <delete id="deleteAsyncTaskByTaskIds" parameterType="String">
        delete from async_task where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>

    <!-- AsyncTaskMapper.xml -->
    <update id="incrProgress" >
    UPDATE async_task
    SET success = success + #{successIncr},skip = skip + #{skipIncr},
        failure = failure + #{failureIncr}
    WHERE task_id = #{taskId}
    </update>


</mapper>