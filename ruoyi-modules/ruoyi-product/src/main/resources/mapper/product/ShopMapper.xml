<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.product.mapper.ShopMapper">
    
    <resultMap type="Shop" id="ShopResult">
        <result property="shopId"    column="shop_id"    />
        <result property="shopName"    column="shop_name"    />
        <result property="platform"    column="platform"    />
        <result property="ownerId"    column="owner_id"    />
        <result property="shopStatus"    column="shop_status"    />
        <result property="shopDescription"    column="shop_description"    />
        <result property="gmtCreate"    column="gmt_create"    />
        <result property="gmtModified"    column="gmt_modified"    />
    </resultMap>

    <sql id="selectShopVo">
        select shop_id, shop_name, platform, owner_id, shop_status, shop_description, gmt_create, gmt_modified from shop
    </sql>

    <select id="selectShopList" parameterType="Shop" resultMap="ShopResult">
        <include refid="selectShopVo"/>
        <where>  
            <if test="shopName != null  and shopName != ''"> and shop_name like concat('%', #{shopName}, '%')</if>
            <if test="platform != null  and platform != ''"> and platform = #{platform}</if>
            <if test="ownerId != null  and ownerId != ''"> and owner_id = #{ownerId}</if>
            <if test="shopStatus != null  and shopStatus != ''"> and shop_status = #{shopStatus}</if>
            <if test="shopDescription != null  and shopDescription != ''"> and shop_description = #{shopDescription}</if>
            <if test="gmtCreate != null "> and gmt_create = #{gmtCreate}</if>
            <if test="gmtModified != null "> and gmt_modified = #{gmtModified}</if>
        </where>
    </select>
    
    <select id="selectShopByShopId" parameterType="String" resultMap="ShopResult">
        <include refid="selectShopVo"/>
        where shop_id = #{shopId}
    </select>

    <insert id="insertShop" parameterType="Shop">
        insert into shop
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="shopId != null">shop_id,</if>
            <if test="shopName != null and shopName != ''">shop_name,</if>
            <if test="platform != null and platform != ''">platform,</if>
            <if test="ownerId != null and ownerId != ''">owner_id,</if>
            <if test="shopStatus != null and shopStatus != ''">shop_status,</if>
            <if test="shopDescription != null">shop_description,</if>
            <if test="gmtCreate != null">gmt_create,</if>
            <if test="gmtModified != null">gmt_modified,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="shopId != null">#{shopId},</if>
            <if test="shopName != null and shopName != ''">#{shopName},</if>
            <if test="platform != null and platform != ''">#{platform},</if>
            <if test="ownerId != null and ownerId != ''">#{ownerId},</if>
            <if test="shopStatus != null and shopStatus != ''">#{shopStatus},</if>
            <if test="shopDescription != null">#{shopDescription},</if>
            <if test="gmtCreate != null">#{gmtCreate},</if>
            <if test="gmtModified != null">#{gmtModified},</if>
         </trim>
    </insert>

    <update id="updateShop" parameterType="Shop">
        update shop
        <trim prefix="SET" suffixOverrides=",">
            <if test="shopName != null and shopName != ''">shop_name = #{shopName},</if>
            <if test="platform != null and platform != ''">platform = #{platform},</if>
            <if test="ownerId != null and ownerId != ''">owner_id = #{ownerId},</if>
            <if test="shopStatus != null and shopStatus != ''">shop_status = #{shopStatus},</if>
            <if test="shopDescription != null">shop_description = #{shopDescription},</if>
            <if test="gmtCreate != null">gmt_create = #{gmtCreate},</if>
            <if test="gmtModified != null">gmt_modified = #{gmtModified},</if>
        </trim>
        where shop_id = #{shopId}
    </update>

    <delete id="deleteShopByShopId" parameterType="String">
        delete from shop where shop_id = #{shopId}
    </delete>

    <delete id="deleteShopByShopIds" parameterType="String">
        delete from shop where shop_id in 
        <foreach item="shopId" collection="array" open="(" separator="," close=")">
            #{shopId}
        </foreach>
    </delete>
</mapper>